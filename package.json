{
  "name": "fuxia-agencia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FUXIA — Agencia de Marketing Digital y Automatización. Pipeline de calidad: ESLint + escaneo de secretos + SonarCloud.",
  "scripts": {
    "build:trafico": "node scripts/build-trafico.mjs",
    "test": "node --test tests/lead.test.mjs",
    "test:cov": "node --test --experimental-test-coverage --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/lead.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "secrets": "node scripts/secrets-scan.mjs",
    "check": "npm run lint && npm run secrets && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
